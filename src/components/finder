import { useState, useEffect, useCallback } from 'react';
import SearchBar from './components/SearchBar';
import UserCard from './components/UserCard';
import Modal from './components/Modal';
import ScrollToTop from './components/ScrollToTop';
import './index.css';

function App() {
  // Core states
  const [username, setUsername] = useState('');
  const [searchQuery, setSearchQuery] = useState('octocat');
  const [userData, setUserData] = useState(null);
  const [loading, setLoading] = useState(false);
  const [error, setError] = useState(null);
  
  // Event listener states
  const [screenSize, setScreenSize] = useState({
    width: window.innerWidth,
    height: window.innerHeight,
    deviceType: getDeviceType()
  });
  
  const [showScrollToTop, setShowScrollToTop] = useState(false);
  const [showModal, setShowModal] = useState(false);
  const [modalContent, setModalContent] = useState('');
  
  // Get device type helper function
  function getDeviceType() {
    const width = window.innerWidth;
    if (width < 768) return '📱 Mobile';
    if (width < 1024) return '💻 Tablet';
    return '🖥️ Desktop';
  }

  // 1. RESIZE LISTENER - Track screen size and device type
  useEffect(() => {
    const handleResize = () => {
      setScreenSize({
        width: window.innerWidth,
        height: window.innerHeight,
        deviceType: getDeviceType()
      });
    };

    // Add event listener
    window.addEventListener('resize', handleResize);
    
    // Cleanup function - REMOVES listener on unmount
    return () => {
      window.removeEventListener('resize', handleResize);
    };
  }, []); // Empty dependency array = runs once on mount

  // 2. SCROLL LISTENER - Show/hide scroll-to-top button
  useEffect(() => {
    const handleScroll = () => {
      // Show button when scrolled 300px from top
      setShowScrollToTop(window.scrollY > 300);
    };

    window.addEventListener('scroll', handleScroll);
    
    // Cleanup on unmount
    return () => {
      window.removeEventListener('scroll', handleScroll);
    };
  }, []); // Empty array = runs once

  // 3. GLOBAL KEYDOWN LISTENER - ESC key functionality
  useEffect(() => {
    const handleKeyDown = (e) => {
      // ESC key = 27 or 'Escape'
      if (e.key === 'Escape' || e.keyCode === 27) {
        if (showModal) {
          // Close modal if open
          setShowModal(false);
        } else if (username) {
          // Clear search input if modal not open
          setUsername('');
          // Optional: Show notification
          showNotification('Search cleared (ESC pressed)');
        }
      }
      
      // Ctrl/Cmd + K to focus search (bonus feature)
      if ((e.ctrlKey || e.metaKey) && e.key === 'k') {
        e.preventDefault();
        document.querySelector('.search-input')?.focus();
      }
    };

    window.addEventListener('keydown', handleKeyDown);
    
    // Cleanup on unmount
    return () => {
      window.removeEventListener('keydown', handleKeyDown);
    };
  }, [showModal, username]); // Dependencies: re-add listener when these change

  // Fetch user data (existing functionality)
  useEffect(() => {
    const fetchUserData = async () => {
      if (!searchQuery) return;
      
      setLoading(true);
      setError(null);
      
      try {
        const response = await fetch(
          `https://api.github.com/users/${searchQuery}`
        );
        
        if (!response.ok) {
          throw new Error(response.status === 404 ? 'User not found' : 'Failed to fetch');
        }
        
        const data = await response.json();
        setUserData(data);
        
        // Show success modal on new search (except initial load)
        if (searchQuery !== 'octocat') {
          setModalContent(`✅ Found user: ${data.login}`);
          setShowModal(true);
        }
      } catch (err) {
        setError(err.message);
        setUserData(null);
        
        // Show error in modal
        setModalContent(`❌ Error: ${err.message}`);
        setShowModal(true);
      } finally {
        setLoading(false);
      }
    };

    fetchUserData();
  }, [searchQuery]);

  // Notification helper
  const showNotification = useCallback((message) => {
    const notification = document.createElement('div');
    notification.className = 'notification';
    notification.textContent = message;
    notification.style.cssText = `
      position: fixed;
      top: 20px;
      right: 20px;
      background: #238636;
      color: white;
      padding: 12px 20px;
      border-radius: 8px;
      z-index: 1000;
      animation: slideIn 0.3s ease;
    `;
    
    document.body.appendChild(notification);
    
    setTimeout(() => {
      notification.style.animation = 'slideOut 0.3s ease';
      setTimeout(() => {
        document.body.removeChild(notification);
      }, 300);
    }, 2000);
  }, []);

  // Event handlers
  const handleSubmit = (e) => {
    e.preventDefault();
    if (username.trim()) {
      setSearchQuery(username.trim());
    }
  };

  const handleSearch = () => {
    if (username.trim()) {
      setSearchQuery(username.trim());
    }
  };

  const handleViewFullProfile = () => {
    if (userData) {
      setModalContent(`
        Opening full profile for ${userData.login}...
        ${userData.html_url}
      `);
      setShowModal(true);
      
      // Actually open in new tab after 1.5s
      setTimeout(() => {
        window.open(userData.html_url, '_blank');
      }, 1500);
    }
  };

  return (
    <div className="app">
      {/* Screen Size Indicator */}
      <div className="screen-info">
        <span className="device-badge">{screenSize.deviceType}</span>
        <span>{screenSize.width} × {screenSize.height}px</span>
        <span>ESC: Clear | Ctrl+K: Focus Search</span>
      </div>

      <header className="app-header">
        <h1>GitHub User Finder</h1>
        <p>Search for any GitHub user by their username</p>
      </header>

      <main className="app-main">
        <SearchBar
          username={username}
          setUsername={setUsername}
          handleSubmit={handleSubmit}
          handleSearch={handleSearch}
          loading={loading}
        />

        {/* User Stats Summary */}
        <div className="stats-summary">
          <div className="stat-item">
            <span className="stat-icon">🔄</span>
            <span>Resize Listener: Active</span>
          </div>
          <div className="stat-item">
            <span className="stat-icon">📜</span>
            <span>Scroll Listener: {showScrollToTop ? 'Active' : 'Inactive'}</span>
          </div>
          <div className="stat-item">
            <span className="stat-icon">⌨️</span>
            <span>Keypress Listener: Active</span>
          </div>
        </div>

        {loading && (
          <div className="loading-state">
            <div className="spinner"></div>
            <p>Searching for {searchQuery}...</p>
          </div>
        )}

        {error && !loading && (
          <div className="error-state">
            <p>❌ Error: {error}</p>
            <p>Please try another username.</p>
          </div>
        )}

        {userData && !loading && !error && (
          <>
            <UserCard userData={userData} />
            <button 
              className="full-profile-btn"
              onClick={handleViewFullProfile}
            >
              View Full Profile in New Tab
            </button>
          </>
        )}

        {!userData && !loading && !error && (
          <div className="initial-state">
            <p>👆 Enter a GitHub username above to get started!</p>
            <p>Try: octocat, gaearon, mikeal, or your own username</p>
            <p className="keyboard-hint">
              💡 Tip: Press <kbd>ESC</kbd> to clear search • <kbd>Ctrl+K</kbd> to focus search
            </p>
          </div>
        )}
      </main>

      {/* Modal Component */}
      <Modal 
        isOpen={showModal}
        onClose={() => setShowModal(false)}
        content={modalContent}
      />

      {/* Scroll to Top Component */}
      <ScrollToTop visible={showScrollToTop} />

      <footer className="app-footer">
        <p>Built with React & GitHub API • Event Listeners Demo</p>
      </footer>
    </div>
  );
}

export default App;




